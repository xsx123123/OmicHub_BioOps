# Matrix Gateway only. Do not copy Matrix credentials into OmicHub settings.
GATEWAY_ENVIRONMENT=production
GATEWAY_OMICHUB_INTEGRATION_TOKEN=replace-omichub-integration-token
GATEWAY_IDENTITIES=bioops-manager:replace-manager-gateway-secret
GATEWAY_MATRIX_HOMESERVER_URL=https://matrix.example.internal
GATEWAY_MATRIX_SERVICE_TOKEN=replace-matrix-appservice-token
# Matrix server_name：动态平台用户账号 @omichub-user-<slug>:<server_name> 的域名部分
GATEWAY_MATRIX_SERVER_NAME=example.internal
GATEWAY_MATRIX_IDENTITIES=bioops-manager=@bioops-manager:example.internal,omichub-user=@omichub-user:example.internal,agent-rnaseq=@agent-rnaseq:example.internal,agent-scrna=@agent-scrna:example.internal,agent-viz=@agent-viz:example.internal,agent-code=@agent-code:example.internal
GATEWAY_ELEMENT_BASE_URL=https://element.example.internal
GATEWAY_AUDIT_LOG_PATH=/var/lib/omichub-agent-gateway/audit.jsonl
GATEWAY_STATE_STORE_URL=redis://omichub-agentteams-state:6379/0

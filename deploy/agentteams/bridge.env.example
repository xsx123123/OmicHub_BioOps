# Never put CygnusX database, Redis, or Docker credentials here.
# MinIO 持久化（Part 1 改造）后 Bridge 需要 MinIO 凭证：复用主栈 MINIO_ROOT_USER/
# MINIO_ROOT_PASSWORD（compose 里经环境变量引用注入，不要在这里写真实值）。
BRIDGE_ENVIRONMENT=production
# 版本可观测字段由镜像构建期 ARG/ENV 注入（BRIDGE_BUILD_SHA/BRIDGE_BUILD_TIME，
# 见 bridge/Dockerfile 与 Makefile 部署 target），不要在此手工填写。
BRIDGE_CYGNUSX_BASE_URL=https://cygnus-x-api.internal
# Configure exactly one upstream credential. An API Key belongs to the dedicated,
# least-privileged CygnusX integration user and is sent as X-API-Key.
BRIDGE_CYGNUSX_SERVICE_TOKEN=replace-with-restricted-service-user-token
# Must match CygnusX AGENTTEAMS_INTEGRATION_TOKEN for capability discovery.
BRIDGE_CYGNUSX_INTEGRATION_TOKEN=replace-agentteams-integration-token
# BRIDGE_CYGNUSX_API_KEY=omh_replace-with-restricted-integration-user-key
# The Bridge, not Workers, owns the Gateway manager credential. This is required by the
# production read-only Worker profile and must remain inside the control-plane network.
BRIDGE_GATEWAY_URL=http://cygnusx-agentteams-gateway:8081
BRIDGE_GATEWAY_MANAGER_TOKEN=replace-with-gateway-manager-token
BRIDGE_STATE_STORE_URL=redis://cygnusx-agentteams-state:6379/0
BRIDGE_STATE_STORE_KEY_PREFIX=cygnusx:agentteams
BRIDGE_APPROVAL_SIGNING_SECRET=replace-with-32-byte-random-secret
BRIDGE_IDENTITIES=approval-authority:replace-human-approval-gateway,bioops-manager:replace-manager,workflow-operator:replace-operator,agent-data:replace-data-worker,agent-rnaseq:replace-rnaseq-worker,agent-atacseq:replace-atacseq-worker,agent-scrna:replace-scrna-worker,agent-scrna-upstream:replace-scrna-upstream-worker,agent-scrna-integration:replace-scrna-integration-worker,agent-scrna-advanced:replace-scrna-advanced-worker,agent-code:replace-code-worker,agent-viz:replace-viz-worker,agent-qc:replace-qc-worker,agent-delivery:replace-delivery-worker,agent-cloud-ops:replace-cloud-ops-worker,agent-general:replace-general-worker,agent-mcp-builder:replace-mcp-builder-worker,analysis-worker:replace-analysis-worker
# Copy each matching value from BRIDGE_IDENTITIES. Worker containers receive only their own token.
AGENTTEAMS_AGENT_CODE_TOKEN=replace-code-worker
AGENTTEAMS_AGENT_VIZ_TOKEN=replace-viz-worker
AGENTTEAMS_AGENT_SCRNA_TOKEN=replace-scrna-worker
AGENTTEAMS_AGENT_RNASEQ_TOKEN=replace-rnaseq-worker
AGENTTEAMS_AGENT_DATA_TOKEN=replace-data-worker
AGENTTEAMS_AGENT_ATACSEQ_TOKEN=replace-atacseq-worker
AGENTTEAMS_AGENT_SCRNA_UPSTREAM_TOKEN=replace-scrna-upstream-worker
AGENTTEAMS_AGENT_SCRNA_INTEGRATION_TOKEN=replace-scrna-integration-worker
AGENTTEAMS_AGENT_SCRNA_ADVANCED_TOKEN=replace-scrna-advanced-worker
AGENTTEAMS_AGENT_QC_TOKEN=replace-qc-worker
AGENTTEAMS_AGENT_DELIVERY_TOKEN=replace-delivery-worker
AGENTTEAMS_AGENT_CLOUD_OPS_TOKEN=replace-cloud-ops-worker
AGENTTEAMS_AGENT_GENERAL_TOKEN=replace-general-worker
AGENTTEAMS_AGENT_MCP_BUILDER_TOKEN=replace-mcp-builder-worker
AGENTTEAMS_ANALYSIS_WORKER_TOKEN=replace-analysis-worker
# Keep this aligned with `data/ai/flows/*.yaml` bridge_workflow values.
BRIDGE_ALLOWED_FLOW_IDS=rna_seq,scrna_seq
# 依据: 待测（经验初值）— 与 BridgeSettings 默认一致；验证: Worker 轮询周期 ×3 基线 + sweep 误回收率
BRIDGE_WORKER_HEARTBEAT_TTL_SECONDS=180
# 失联 Worker 租约的后台清扫间隔（秒）；0 关闭（关闭后回收只随 Worker inbox 轮询惰性触发）。
# 依据: 待测（经验初值）— 应远小于 heartbeat TTL(180s)；验证: 失联到回收的实测延迟
BRIDGE_WORK_ITEM_SWEEP_INTERVAL_SECONDS=30
# 依据: 待测（经验初值）— 以下三项为容量护栏，与 BridgeSettings 默认一致；验证: 压测并发 Case/工作项与 Worker 池容量
BRIDGE_MAX_ACTIVE_CASES_PER_REQUESTER=3
BRIDGE_MAX_ACTIVE_CASES_PER_PROJECT=5
BRIDGE_MAX_ACTIVE_WORK_ITEMS_PER_CASE=8
# 依据: 待测（经验初值）— 单 Worker 容器并发领单数；验证: 压测单容器 CPU/内存与 LLM 速率限制
AGENTTEAMS_WORKER_MAX_CONCURRENT=2
# 依据: 待测（经验初值）— 1MiB 覆盖立项/计划 JSON 正常体积；验证: 监控超界拒绝日志
BRIDGE_MAX_REQUEST_BYTES=1048576
# 依据: 待测（经验初值）— 同上，响应侧对称口径
BRIDGE_MAX_RESPONSE_BYTES=1048576
BRIDGE_AUDIT_LOG_PATH=/var/lib/cygnusx-agentteams-bridge/audit.jsonl
BRIDGE_CASE_STORE_PATH=/var/lib/cygnusx-agentteams-bridge/cases.json
BRIDGE_MANIFEST_DIR=/var/lib/cygnusx-agentteams-bridge/manifests
# MinIO 持久层（事实源；生产环境强制要求，BRIDGE_MINIO_ENDPOINT 为空时生产校验器拒绝启动）。
# 跨栈经 cygnusx_net 直连主栈 minio 容器；bucket 由主栈 minio-init 负责创建。
BRIDGE_MINIO_ENDPOINT=http://minio:9000
BRIDGE_MINIO_ACCESS_KEY=replace-with-minio-root-user
BRIDGE_MINIO_SECRET_KEY=replace-with-minio-root-password
BRIDGE_MINIO_BUCKET=agentteams
BRIDGE_MINIO_SECURE=false

# AgentTeams-owned control-plane configuration. Do not place OmicHub database, Redis,
# Docker socket, user-data paths, or workflow directories in this file.

# Deploy the official AgentTeams/HiClaw Helm chart in a separate namespace. Its default
# profile owns Controller, Higress, Tuwunel Matrix, MinIO, and Element Web. Join only the
# control network and call the Bridge URL below; do not mount OmicHub worker data.
AGENTTEAMS_BRIDGE_BASE_URL=http://omichub-agentteams-bridge:8080/v1
AGENTTEAMS_BRIDGE_BIND_HOST=127.0.0.1
AGENTTEAMS_BRIDGE_PORT=8088
AGENTTEAMS_GATEWAY_BIND_HOST=127.0.0.1
AGENTTEAMS_GATEWAY_PORT=8089
GATEWAY_ENV_FILE=./gateway.env
AGENTTEAMS_TEAM_CONFIG=../../integrations/agentteams/teams/bioops-delivery.yaml
AGENTTEAMS_SKILL_CONTRACTS=../../integrations/agentteams/skills/contracts.yaml

# The read-only deployment verifier expects this separate namespace after the official Helm chart
# is installed. It never creates resources or submits work.
AGENTTEAMS_CONTROL_NAMESPACE=agentteams-system

# Configure Matrix/MinIO/Higress through the target AgentTeams release's official schema.
# Shared storage may contain small manifests and summaries only; never FASTQ/BAM/reference data.
AGENTTEAMS_MATRIX_ROOM_ID=
AGENTTEAMS_MINIO_BUCKET=agentteams-evidence

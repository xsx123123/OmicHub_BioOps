# CygnusX host logrotate policy
# Install example:
#   sudo cp deploy/logrotate/cygnusx-logs /etc/logrotate.d/cygnusx-logs

/data/cygnusx/logs/nginx/*.log {
    daily
    rotate 14
    size 100M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}

/data/cygnusx/logs/snakemake/*/*/*.log {
    daily
    rotate 7
    size 200M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}

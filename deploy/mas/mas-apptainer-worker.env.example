# Native host worker: do not run this service in Docker and do not grant it Docker access.
APP_ENV=production
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
CELERY_BROKER_URL=redis://:replace-me@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:replace-me@127.0.0.1:6379/2
MAS_ENABLED=true
MAS_WORKSPACE_ROOT=/data/cygnusx
MAS_APPTAINER_BINARY=/usr/bin/apptainer
MAS_APPTAINER_IMAGE=/data/cygnusx/images/rnaflow.sif
MAS_APPTAINER_PIPELINE_ROOT=/opt/cygnusx/pipelines/RNAFlow

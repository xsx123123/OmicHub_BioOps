# ============================================
# OmicHub 环境变量配置模板
# ============================================
# 使用方式：
#   cp .env.example .env
#   chmod 600 .env
#
# `.env` 含密码、令牌和云端密钥，已被 Git 忽略，绝不能提交。
# 生产环境必须替换所有 `change-me-*`、`replace-with-*` 和开发环境默认密码。
# AgentTeams Bridge 的身份令牌应配置在 `deploy/agentteams/bridge.env`，
# 该文件同样不可提交；启动步骤见 `deploy/agentteams/README.md`。

# ===== 应用配置 =====
APP_NAME=OmicHub
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string
SERVICE_NAME=web

# ===== 首次部署管理员初始化 =====
# 生产环境必须设置强密码；开发环境留空会使用默认弱密码并打印警告。
# 注意：变量名中的 OMICHBUB 为已有兼容拼写，请勿改为 OMICHUB。
OMICHBUB_INIT_ADMIN_USERNAME=admin
OMICHBUB_INIT_ADMIN_EMAIL=admin@example.com
OMICHBUB_INIT_ADMIN_PASSWORD=

# ===== 数据库配置 =====
# 本地 Docker Compose 默认使用服务名 db。生产环境请使用强密码，并同步修改 DATABASE_URL。
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=omichub
POSTGRES_PASSWORD=omichub_dev_password
POSTGRES_DB=omichub
DATABASE_URL=postgresql+asyncpg://omichub:omichub_dev_password@db:5432/omichub
# PolarDB 只读节点仅用于显式只读工作负载/验收，迁移和写入必须始终使用 DATABASE_URL。
READONLY_DATABASE_URL=
# Web 进程使用 SQLAlchemy QueuePool；Celery/Beat 为避免跨 asyncio 事件循环复用连接，保持 NullPool。
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# ===== Redis / Celery 配置 =====
# 本地 Docker Compose 默认使用服务名 cache。生产环境请替换密码，并同步修改两个 URL。
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=omichub_dev_redis_password
REDIS_DB=0
CELERY_BROKER_URL=redis://:omichub_dev_redis_password@cache:6379/1
CELERY_RESULT_BACKEND=redis://:omichub_dev_redis_password@cache:6379/2

# ===== MinIO 对象存储（AgentTeams agent 间共享产物 / case 级数据区） =====
# 容器内访问地址 http://minio:9000；宿主机默认仅 127.0.0.1:9000（API）/9001（控制台）
MINIO_ROOT_USER=omichub_minio_admin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_AGENTTEAMS_BUCKET=agentteams-evidence
AGENTTEAMS_ARTIFACT_FETCH_MAX_MB=512
AGENTTEAMS_REPORT_PREVIEW_MAX_MB=20
OMICHUB_MINIO_BIND_HOST=127.0.0.1
OMICHUB_MINIO_PORT=9000
OMICHUB_MINIO_CONSOLE_PORT=9001

# ===== JWT / CORS 配置 =====
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 必须是 JSON 数组；生产环境仅保留实际 HTTPS 域名。
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== AI Provider 配置 =====
# Provider 列表在 data/ai/providers.yaml 中维护（单一事实源）；
# 网页端增删改模型后会自动回写该 YAML，但 API Key 不落盘（只写 ${ENV_KEY} 占位）。
# 命名约定：provider 名 "qwen3.7-plus" 对应占位 ${DEEPSEEK_V4_FLASH_API_KEY}（大写+下划线+_API_KEY）。
# 真实密钥只填在这里或部署系统的 Secret 中，启动时由 loader 自动解析进 DB。
AI_PROVIDER_CONFIG_YAML=data/ai/providers.yaml
AI_PROVIDER_KEY_ENCRYPTION_KEY=
# 以下密钥按已配置的 Provider 需要填写；空值表示不启用该 Provider。
AL_API_KEY=
ARK_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
# 如需兼容旧单 Provider 兜底，可设置以下变量；通常无需修改。
LLM_PROVIDER=kimi
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# 首 token 前的模型网络/5xx 瞬时故障自动重试（已输出正文后不重试，避免重复回复）。
LLM_STREAM_TRANSIENT_RETRIES=3
LLM_STREAM_RETRY_BASE_DELAY_SECONDS=0.8
# 联网搜索：相同问题的模型精炼检索式缓存 24 小时；Redis 不可用时自动使用进程内缓存。
WEB_SEARCH_REFINEMENT_CACHE_TTL_SECONDS=86400
# 标题/摘要语义重排；模型留空时复用 AGENT_MEMORY_EMBEDDING_MODEL，均为空则回退词项重排。
WEB_SEARCH_SEMANTIC_RERANK_ENABLED=true
WEB_SEARCH_EMBEDDING_MODEL=

# ===== 文件与共享存储 =====
# 所有 Web、Worker、Slurm 计算节点必须将同一逻辑任务目录挂载为相同容器路径。
STORAGE_TYPE=local
STORAGE_PATH=/data/omichub
# 受控 directory:// Session 引用的扫描保护：仅生成分页 Manifest，不复制大型输入。
WORKSPACE_DIRECTORY_MAX_FILES=10000
WORKSPACE_DIRECTORY_MAX_TOTAL_BYTES=53687091200
WORKSPACE_DIRECTORY_MANIFEST_PAGE_SIZE=200
WORKSPACE_DIRECTORY_SCAN_TIMEOUT_SECONDS=5
# 普通聊天轻量沙箱空闲回收时间（秒）；默认 5 分钟。
SANDBOX_SESSION_TIMEOUT=300
UPLOAD_DIR=uploads
RESULTS_DIR=results
# 任务运行时的 Conda/Mamba 缓存必须位于可写共享目录；不建议使用镜像内路径。
SNAKEMAKE_CORES=4
SNAKEMAKE_USE_CONDA=true
SNAKEMAKE_CONDA_PREFIX=/data/omichub/.conda_envs

# ===== 下载工具（按已安装的二进制启用） =====
ENABLE_EBI_DOWNLOAD=false
ENABLE_DIRECT_DOWNLOAD=false
ENABLE_CLOUD_STORAGE_DOWNLOAD=false
EBI_DOWNLOAD_BINARY=/data/omichub/bin/EBIDownload
EBI_DOWNLOAD_YAML=/data/omichub/bin/EBIDownload.yaml
CLOUD_OSSUTIL_BINARY=/data/omichub/bin/ossutil
CLOUD_TOSUTIL_BINARY=/data/omichub/bin/tosutil
CLOUD_OBSUTIL_BINARY=/data/omichub/bin/obsutil
DIRECT_DOWNLOAD_BINARY=/usr/bin/aria2c

# ===== Docker Compose：本机部署网络、端口与共享目录 =====
# 不要为容器分配固定 IP：同一 Compose 项目中的服务通过 web、db、cache 等服务名通信。
# 以下是“宿主机发布地址”，用于浏览器、跨机器 Worker 或运维工具访问。
OMICHUB_DATA_ROOT=/data/omichub
OMICHUB_HTTP_BIND_HOST=0.0.0.0
OMICHUB_HTTP_PORT=8888
# 单机默认仅将 Web 内部 API、PostgreSQL、Redis 和 Flower 绑定到回环地址。
# 跨机器时改为控制面服务器的私网 IP，并只在防火墙/VPN 内放行给 Worker 节点。
OMICHUB_WEB_BIND_HOST=127.0.0.1
OMICHUB_WEB_PORT=8000
OMICHUB_POSTGRES_BIND_HOST=127.0.0.1
OMICHUB_POSTGRES_PORT=5432
OMICHUB_REDIS_BIND_HOST=127.0.0.1
OMICHUB_REDIS_PORT=6379
OMICHUB_FLOWER_BIND_HOST=127.0.0.1
OMICHUB_FLOWER_PORT=5555
# 跨栈 Docker 网络名；Make 与 Compose 均读取这些值。
OMICHUB_NETWORK_NAME=omichub_net
OMICHUB_SANDBOX_NETWORK_NAME=omichub-sandbox-net
OMICHUB_BRIDGE_GATEWAY_NETWORK=omichub_bridge_gateway

# ===== 容器化分析工具 =====
# 富集分析默认不传 --network，Docker 使用本机默认 bridge，避免附着到残留的
# Compose / Swarm 网络。仅在容器必须访问特定内网服务时填写已验证的本机 bridge 网络名。
ENRICHMENT_DOCKER_NETWORK=
# 可选：KEGG REST 出站代理；为空则使用 Docker bridge 的默认出网路径。
ENRICHMENT_PROXY_URL=

# ===== Docker Compose：跨机器控制面 / Worker 配置 =====
# 仅在使用 docker-compose.cross-web.yml 与 docker-compose.cross-worker.yml 时填写。
# 控制面机器：将三个 *_BIND_HOST 设为本机私网 IP，并填写相同的 CONTROL_HOST。
# Worker 机器：CONTROL_HOST 指向控制面私网 IP/DNS；不要把 127.0.0.1 填给跨机 Worker。
OMICHUB_CONTROL_HOST=
OMICHUB_CONTROL_WEB_PORT=8000
OMICHUB_CONTROL_POSTGRES_PORT=5432
OMICHUB_CONTROL_REDIS_PORT=6379
OMICHUB_CONTROL_ROCKETMQ_NAMESRV_PORT=9876
OMICHUB_CONTROL_NETWORK_NAME=omichub_control_net
OMICHUB_CONTROL_NETWORK_SUBNET=172.30.0.0/16
OMICHUB_WORKER_NETWORK_NAME=omichub_worker_net
# Worker 可直接由 .env 提供宿主机路径；未设置时回退 data/worker_config.yaml。
# 在每台 Worker 上分别填写本机已挂载的 NAS 路径与流程目录。
WORKER_SHARED_DATA_DIR=
WORKER_PIPELINE_DIR=

# ===== Docker Compose / Worker 镜像配置 =====
COMPOSE_PROJECT_NAME=omichub
# app 容器运行用户；修改为宿主机实际 UID/GID，避免共享 NAS 产生 root 属主文件。
PUID=1000
PGID=1000
# Worker 映像与并发参数（按部署规模调整）。
OMICHUB_WORKER_IMAGE=omichub-worker:dev
OMICHUB_PHYLO_WORKER_IMAGE=omichub-phylo-worker:dev
PHYLO_WORKER_THREADS=4
PHYLO_WORKER_CONCURRENCY=2
# 仅在需要保护 Flower 控制台时设置，格式为 username:password。
FLOWER_BASIC_AUTH=

# RocketMQ profile 仅在启用 RocketMQ 时开放；默认只监听本机，跨机器时应使用私网地址。
ROCKETMQ_IMAGE=apache/rocketmq:5.3.2
OMICHUB_ROCKETMQ_NAMESRV_BIND_HOST=127.0.0.1
OMICHUB_ROCKETMQ_NAMESRV_PORT=9876
OMICHUB_ROCKETMQ_BROKER_BIND_HOST=127.0.0.1
OMICHUB_ROCKETMQ_BROKER_VIP_PORT=10909
OMICHUB_ROCKETMQ_BROKER_PORT=10911
OMICHUB_ROCKETMQ_BROKER_FAST_PORT=10912

# ===== 工作流监控 =====
# Token 同时配置给 Web 与 Worker；生产环境请使用高熵随机值。
WORKFLOW_MONITOR_ENABLED=false
WORKFLOW_MONITOR_INGEST_TOKEN=
OMICHUB_WORKFLOW_MONITOR_TOKEN=

# ===== Multi-Agent：平台内协作 =====
# 默认全部关闭。先启用“轻量协作”，观察降级和成本后再开启 Fan-out 或 MAS。
# 运行时也可在「系统管理 → 平台设置 → 协作」选择协作档位；任一环境变量为 true
# 会强制开启相应能力。完整说明见 docs/configuration/多Agent协作配置指南.md。
UNIFIED_INTENT_ROUTER_ENABLED=false
MULTI_EXPERT_CONSULTATION_ENABLED=false
MULTI_EXPERT_CONSULTATION_MAX_EXPERTS=3
OVERDRIVE_AUTHORITATIVE_MODE=constraint
OVERDRIVE_PLAN_REPAIR_ENABLED=true
SUBAGENT_FANOUT_ENABLED=false
SUBAGENT_MAX_PARALLEL=4
SUBAGENT_MAX_CONCURRENT=3
SUBAGENT_CHILD_TIMEOUT_SECONDS=1200
SUBAGENT_MAX_ROUNDS_PER_CHILD=24
SUBAGENT_MAX_CHILDREN_PER_MESSAGE=1

# 轻量协作示例（仅路由与专家会诊）：
# UNIFIED_INTENT_ROUTER_ENABLED=true
# MULTI_EXPERT_CONSULTATION_ENABLED=true
#
# 并行增强示例（在轻量协作稳定后再开启）：
# SUBAGENT_FANOUT_ENABLED=true

# ===== MAS：受控流程编排（可选） =====
# 这与 AgentTeams Bridge 独立；仅在已准备 Apptainer/Docker 流程运行时后启用。
MAS_ENABLED=false
MAS_WORKSPACE_ROOT=/data/omichub
MAS_APPTAINER_BINARY=apptainer
MAS_APPTAINER_IMAGE=
MAS_APPTAINER_PIPELINE_ROOT=/opt/omichub/pipelines/RNAFlow
MAS_SCRNA_DOCKER_IMAGE=omichub-analysis:scrna-2026.07
MAS_SCRNA_TIMEOUT_SECONDS=7200

# 持久 Goal Runtime：默认关闭。开启后通过 /api/v1/goals/start 发起后台自治循环。
GOAL_RUNTIME_ENABLED=false
# Goal 内复用 parallel_subagents，并将父/子任务持久化为 Work Unit；默认关闭。
GOAL_FANOUT_ENABLED=false
GOAL_LEASE_SECONDS=120
GOAL_CONTINUATION_DELAY_SECONDS=1

# ===== AgentTeams Bridge：跨系统协作闭环（默认关闭） =====
# 启用前必须先部署 Bridge，并在 deploy/agentteams/bridge.env 为每个身份创建独立令牌。
# 仅开启本节变量不会启动 AgentTeams Worker；其控制面和 Worker 应独立部署。
AGENTTEAMS_BRIDGE_ENABLED=false
AGENTTEAMS_CHAT_ENTRY_ENABLED=false
# Docker Compose 内使用服务名；跨机器/Kubernetes 部署时改为受 TLS 保护的内部 URL。
AGENTTEAMS_BRIDGE_URL=http://omichub-agentteams-bridge:8080
# Agent 执行 Gateway 凭证仅存在于 Gateway 容器；OmicHub 只使用受控的 Manager 身份。
AGENTTEAMS_GATEWAY_ENABLED=false
AGENTTEAMS_GATEWAY_URL=http://omichub-agentteams-gateway:8081
AGENTTEAMS_GATEWAY_MANAGER_TOKEN=
AGENTTEAMS_GATEWAY_TIMEOUT_SECONDS=10
AGENTTEAMS_BRIDGE_MANAGER_TOKEN=replace-with-bioops-manager-token
AGENTTEAMS_BRIDGE_DATA_STEWARD_TOKEN=replace-with-data-steward-token
AGENTTEAMS_BRIDGE_APPROVAL_TOKEN=replace-with-approval-authority-token
AGENTTEAMS_BRIDGE_WORKFLOW_OPERATOR_TOKEN=replace-with-workflow-operator-token
AGENTTEAMS_BRIDGE_TIMEOUT_SECONDS=10
AGENTTEAMS_CHAT_FLOW_WHITELIST=rna_seq,atac_seq,scrna_seq
AGENTTEAMS_CASE_WATCH_INTERVAL_SECONDS=60
# Keep the default dual write until the migration reconciliation stays clean for three days.
AGENTTEAMS_CASE_CURSOR_MIGRATION_MODE=dual_write
AGENTTEAMS_INTEGRATION_TOKEN=replace-agentteams-integration-token
AGENTTEAMS_STALE_TASK_SECONDS=600
# Bridge 容器宿主机发布地址（由 deploy/agentteams/docker-compose.agentteams.yml 使用）。
AGENTTEAMS_BRIDGE_BIND_HOST=127.0.0.1
AGENTTEAMS_BRIDGE_PORT=8088

# AgentTeams 启用最小示例（确认 Bridge 与独立 Worker 健康后取消以下注释）：
# AGENTTEAMS_BRIDGE_ENABLED=true
# AGENTTEAMS_CHAT_ENTRY_ENABLED=true
# AGENTTEAMS_BRIDGE_URL=https://agentteams-bridge.example.internal
# AGENTTEAMS_BRIDGE_MANAGER_TOKEN=replace-with-real-manager-token
# AGENTTEAMS_BRIDGE_DATA_STEWARD_TOKEN=replace-with-real-data-steward-token
# AGENTTEAMS_BRIDGE_APPROVAL_TOKEN=replace-with-real-approval-token
# AGENTTEAMS_BRIDGE_WORKFLOW_OPERATOR_TOKEN=replace-with-real-workflow-operator-token

# ===== Agent 记忆与观测（可选） =====
AGENT_MEMORY_SEMANTIC_RETRIEVAL_ENABLED=false
AGENT_MEMORY_EMBEDDING_MODEL=
AGENT_MEMORY_AUTO_SUMMARY_ENABLED=false
AGENT_MEMORY_SUMMARY_MODEL=
AGENT_MEMORY_CONFLICT_ADJUDICATION_ENABLED=false
AGENT_MEMORY_CONFLICT_ADJUDICATION_MODEL=

# ----- mem0 记忆引擎（26.8.4+，推荐） -----
# 以 mem0 v2 替换自研记忆内核：LLM 事实抽取 + 语义去重 + pgvector 向量检索。
# 开启后上面的 AGENT_MEMORY_* 旧开关不再生效（旧链路保留为回滚位）。
# 改本段后必须 `docker compose up -d` 重建 web/worker（restart 不重读 env_file）。
# 实施方案与灰度踩坑记录：docs/26.8.4/OmicHub_mem0记忆引擎替换实施方案.md
MEM0_ENGINE_ENABLED=false
# 记忆事实抽取 LLM（填 AI Provider 注册表中的 provider 名或模型名；凭据自动解析）。
MEM0_EXTRACTION_MODEL=qwen3.7-plus
# Embedder：fastembed（进程内 ONNX，默认）| ollama（独立服务）| openai（兼容端点）。
MEM0_EMBEDDING_PROVIDER=fastembed
# fastembed：多语言模型名；ollama/openai 时改为对应模型名（如 bge-m3）。
MEM0_EMBEDDING_MODEL=intfloat/multilingual-e5-large
MEM0_EMBEDDING_DIMS=1024
# 仅 MEM0_EMBEDDING_PROVIDER=ollama 时使用（compose 备用服务 omichub-embed，profile: embed-ollama）。
#MEM0_OLLAMA_BASE_URL=http://omichub-embed:11434
# 仅 MEM0_EMBEDDING_PROVIDER=openai 时使用。
MEM0_OPENAI_BASE_URL=
MEM0_OPENAI_API_KEY=
# pgvector 独立 collection（不触碰旧 agent_memories 表）。
MEM0_COLLECTION=mem0_memories
# 记忆数据目录：主密钥 master.key(0600) 与 history 审计库落盘于此（web/worker 须共享可写）。
MEM0_DATA_DIR=/data/omichub/omichub_data/_mem0
# 记忆内容静态加密（Fernet）：落库的 payload 为密文，读取时引擎解密。
MEM0_ENCRYPTION_ENABLED=true
# 留空则首次启动自动生成密钥并持久化到 MEM0_DATA_DIR/master.key；
# 多副本/灾备场景建议显式配置同一密钥。密钥丢失 = 存量记忆不可恢复。
MEM0_ENCRYPTION_KEY=
# mem0 历史审计 sqlite 目录；留空则落 MEM0_DATA_DIR/history（内容同样加密）。
#MEM0_HISTORY_DIR=
# 每累计 N 条消息异步沉淀一次会话记忆（删会话时也会触发沉淀）。
MEM0_SETTLE_EVERY_N_MESSAGES=6
# 检索/查重分数阈值（按 embedder 实测分布调整；
# e5-large 无前缀实测：无关≈0.80，跨话题≈0.85，同领域相关≥0.90，同义≥0.96）。
MEM0_SEARCH_SCORE_THRESHOLD=0.87
MEM0_DEDUP_SIMILARITY_THRESHOLD=0.95
# fastembed 模型缓存目录：建议 web/worker 共享的可写卷；缓存为空时首次加载自动下载，
# 国内网络需要 HF_ENDPOINT 镜像源。
FASTEMBED_CACHE_PATH=/data/omichub/mem0-cache
HF_ENDPOINT=https://hf-mirror.com

TELEMETRY_ENABLED=true
OTEL_EXPORTER_ENDPOINT=
METRICS_ENABLED=true

# ===== 阿里云 Skills（可选） =====
# 仅在启用阿里云 Skills 集成时填写；使用最小权限 AK，并优先由部署平台 Secret 注入。
ALIYUN_SKILLS_ACCESS_KEY_ID=
ALIYUN_SKILLS_ACCESS_KEY_SECRET=
ALIYUN_SKILLS_REGION_ID=cn-hangzhou

# ===== 任务队列（Celery + RocketMQ 兼容） =====
# celery：默认，保持现有任务传输；
# rocketmq：全部业务任务走 RocketMQ；
# hybrid：仅 ROCKETMQ_TASK_ROUTES 匹配的任务走 RocketMQ，适用于灰度迁移。
TASK_QUEUE_BACKEND=celery
ROCKETMQ_NAMESRV_ADDR=rocketmq-namesrv:9876
ROCKETMQ_PRODUCER_GROUP=omichub-task-producer
ROCKETMQ_CONSUMER_GROUP_PREFIX=omichub-task-worker
ROCKETMQ_TOPIC_PREFIX=omichub_task
ROCKETMQ_TASK_ROUTES=[]
# 灰度示例：
# TASK_QUEUE_BACKEND=hybrid
# ROCKETMQ_TASK_ROUTES=["omichub.tools.blast.tasks.*"]

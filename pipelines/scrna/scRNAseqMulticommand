# --- Dynamic Memory Allocation for future.globals.maxSize ---
get_optimal_max_size <- function(default_mb = 8000) {
  # Try to get total memory on Linux
  mem_info <- tryCatch({
    if (file.exists("/proc/meminfo")) {
      mem_total_kb <- as.numeric(gsub("[^0-9]", "", grep("MemTotal", readLines("/proc/meminfo"), value = TRUE)))
      # Use 80% of total memory to be safe in Docker
      as.integer((mem_total_kb / 1024) * 0.8)
    } else {
      default_mb
    }
  }, error = function(e) default_mb)
  
  # Ensure at least the default value
  final_mb <- max(mem_info, default_mb)
  return(final_mb)
}

TOTAL_MEM_MB <- get_optimal_max_size()

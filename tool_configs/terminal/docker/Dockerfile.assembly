# OmicHub 基因组组装沙盒镜像
# 构建: docker build -t omichub/sandbox-assembly:latest -f tool_configs/terminal/docker/Dockerfile.assembly tool_configs/terminal/docker/
FROM omichub/sandbox-terminal:latest

USER root

# 二代 SPAdes、组装评估 BUSCO 与长读段比对走 apt（jammy 仓库有）；
# flye / quast 不在 Ubuntu 22.04 官方仓库（2026-07-28 实测 no installation candidate），
# 改用 micromamba + bioconda（USTC 镜像）安装。
RUN apt-get update && apt-get install -y --no-install-recommends \
      spades busco minimap2 samtools \
    && rm -rf /var/lib/apt/lists/*

# micromamba 二进制从官方镜像复制（与 Dockerfile.worker 同路线），避免境外下载
COPY --from=mambaorg/micromamba:2.0.5 /usr/bin/micromamba /usr/local/bin/micromamba

ENV MAMBA_ROOT_PREFIX=/opt/conda \
    MAMBA_NO_BANNER=1

# 预置中科大镜像源（见 Protocol/镜像构建国内加速规范_v1.md §4）
# 注意：基础镜像设了 ENV HOME=/home/omichub，即使 USER root，micromamba 也按 HOME 找
# .condarc——必须写进 /home/omichub（2026-07-28 实测：写 /root/.condarc 会被完全忽略，
# 静默回退 conda.anaconda.org 境外下载）。
RUN printf '%s\n' \
      'show_channel_urls: true' \
      'default_channels:' \
      '  - https://mirrors.ustc.edu.cn/anaconda/pkgs/main' \
      '  - https://mirrors.ustc.edu.cn/anaconda/pkgs/free' \
      '  - https://mirrors.ustc.edu.cn/anaconda/pkgs/r' \
      '  - https://mirrors.ustc.edu.cn/anaconda/pkgs/msys2' \
      'custom_channels:' \
      '  conda-forge: https://mirrors.ustc.edu.cn/anaconda/cloud' \
      '  bioconda: https://mirrors.ustc.edu.cn/anaconda/cloud' \
      '  menpo: https://mirrors.ustc.edu.cn/anaconda/cloud' \
      'channel_priority: flexible' \
      'channels:' \
      '  - conda-forge' \
      '  - bioconda' \
      '  - menpo' \
      '  - defaults' \
      > /home/omichub/.condarc \
    && cp /home/omichub/.condarc /root/.condarc \
    && chown omichub:omichub /home/omichub/.condarc

RUN micromamba create -y -n asm -c conda-forge -c bioconda \
      flye quast \
    && micromamba clean -afy \
    && ln -sf /opt/conda/envs/asm/bin/flye /usr/local/bin/flye \
    && ln -sf /opt/conda/envs/asm/bin/quast.py /usr/local/bin/quast

USER 1000
